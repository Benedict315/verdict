{
  "name": "verdict-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Verdict - Pre-action security gate for autonomous agents",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace=apps/api run dev",
    "dev:web": "npm --workspace=apps/web run dev",
    "build": "npm run build --workspaces --if-present",
    "test:api": "tsx scripts/verify-phase1.ts",
    "test:security": "tsx scripts/test-token-bypass.ts",
    "test:chain": "tsx scripts/test-chain-failure.ts",
    "seed": "npm --workspace=apps/api run seed",
    "contracts:compile": "npm --workspace=packages/contracts run compile",
    "contracts:test": "npm --workspace=packages/contracts exec hardhat test",
    "contracts:deploy": "npm --workspace=packages/contracts run deploy:sepolia",
    "contracts:verify": "npm --workspace=packages/contracts exec hardhat verify --network baseSepolia"
  },
  "keywords": [
    "verdict",
    "ai-agents",
    "security-gate",
    "base-sepolia",
    "hackathon"
  ],
  "author": "",
  "license": "MIT"
}
